  "rules": [
    {
      "id": "primary.security-code",
      "description": "A personal authentication code, with code-use instructions.",
      "mode": "decision",
      "priority": 100,
      "when": {
        "all": [
          {
            "field": "subject",
            "op": "regex",
            "value": "^(?:your verification code|your authentication code|your login code|your security code|your one-time code|your one time password|your 2fa code)\\b"
          },
          {
            "field": "text",
            "op": "regex",
            "value": "\\b(?:expires in|do not share|never share|use this code|your code is)\\b"
          }
        ]
      },
      "set": {
        "category": "primary",
        "newsletter": false,
        "time_sensitive": true
      },
      "sources": [
        "gmail-inbox-cleaner",
        "dakia"
      ]
    },
    {
      "id": "primary.security-alert",
      "description": "A security alert asking the recipient to review account activity.",
      "mode": "decision",
      "priority": 100,
      "when": {
        "all": [
          {
            "field": "subject",
            "op": "regex",
            "value": "^(?:security alert|sign-in attempt|sign in attempt|unrecognized login|suspicious activity|new sign-in|new sign in)\\b"
          },
          {
            "field": "text",
            "op": "regex",
            "value": "\\b(?:was this you|if this was not you|if this wasn't you|secure your account|review activity)\\b"
          }
        ]
      },
      "set": {
        "category": "primary",
        "newsletter": false,
        "time_sensitive": true
      },
      "sources": [
        "gmail-inbox-cleaner",
        "dakia"
      ]
    },
    {
      "id": "primary.password-reset",
      "description": "A requested password reset, with reset instructions.",
      "mode": "decision",
      "priority": 100,
      "when": {
        "all": [
          {
            "field": "subject",
            "op": "regex",
            "value": "^(?:reset your password|your password reset|password reset request)\\b"
          },
          {
            "field": "text",
            "op": "regex",
            "value": "\\b(?:reset your password|reset password|expires in|you requested)\\b"
          }
        ]
      },
      "set": {
        "category": "primary",
        "newsletter": false,
        "time_sensitive": true
      },
      "sources": [
        "gmail-inbox-cleaner",
        "dakia"
      ]
    },
    {
      "id": "primary.payment-failure",
      "description": "A failed payment that requires a retry or payment-method update.",
      "mode": "decision",
      "priority": 100,
      "when": {
        "all": [
          {
            "any": [
              {
                "field": "subject",
                "op": "regex",
                "value": "^(?:payment failed|payment declined|payment unsuccessful|could not process your payment|your payment was declined)\\b"
              },
              {
                "all": [
                  {
                    "field": "subject",
                    "op": "regex",
                    "value": "^your invoice\\b"
                  },
                  {
                    "field": "subject",
                    "op": "regex",
                    "value": "\\bpayment failed\\b"
                  }
                ]
              }
            ]
          },
          {
            "field": "text",
            "op": "regex",
            "value": "\\b(?:retry|try again|update your payment|update your card|payment method)\\b"
          }
        ]
      },
      "set": {
        "category": "primary",
        "newsletter": false,
        "time_sensitive": true
      },
      "sources": [
        "gmail-inbox-cleaner",
        "dakia"
      ]
    },
    {
      "id": "primary.action-required",
      "description": "An explicit action request with supporting instructions, excluding marketing and subscriptions.",
      "mode": "decision",
      "priority": 85,
      "when": {
        "all": [
          {
            "field": "subject",
            "op": "regex",
            "value": "^(?:action required|response required|approval required)\\b"
          },
          {
            "field": "text",
            "op": "regex",
            "value": "\\b(?:please approve|please respond|complete verification|submit your response|deadline|expires on)\\b"
          },
          {
            "not": {
              "any": [
                {
                  "field": "subject",
                  "op": "regex",
                  "value": "\\b(?:[0-9]{1,3}%[ \\t]{0,3}off|discount|coupon|flash sale|on sale|special offer|exclusive offer|promo code|promotion code|clearance)\\b"
                },
                {
                  "field": "text",
                  "op": "regex",
                  "value": "\\b(?:[0-9]{1,3}%[ \\t]{0,3}off|discount|coupon|flash sale|on sale|special offer|exclusive offer|promo code|promotion code|clearance)\\b"
                }
              ]
            }
          },
          {
            "not": {
              "any": [
                {
                  "field": "headers.list-id",
                  "op": "present"
                },
                {
                  "field": "headers.list-unsubscribe",
                  "op": "present"
                },
                {
                  "field": "headers.list-unsubscribe-post",
                  "op": "present"
                },
                {
                  "field": "headers.precedence",
                  "op": "regex",
                  "value": "^(?:bulk|list)$"
                }
              ]
            }
          }
        ]
      },
      "set": {
        "category": "primary",
        "newsletter": false,
        "time_sensitive": true
      },
      "sources": [
        "dakia"
      ]
    },
    {
      "id": "primary.correspondence",
      "description": "A verified correspondent in a reply thread without bulk or automation signals.",
      "mode": "decision",
      "priority": 90,
      "when": {
        "all": [
          {
            "field": "sender_address",
            "op": "present"
          },
          {
            "field": "verified_correspondent",
            "op": "equals",
            "value": true
          },
          {
            "any": [
              {
                "field": "headers.in-reply-to",
                "op": "present"
              },
              {
                "field": "headers.references",
                "op": "present"
              }
            ]
          },
          {
            "not": {
              "any": [
                {
                  "field": "headers.list-id",
                  "op": "present"
                },
                {
                  "field": "headers.list-unsubscribe",
                  "op": "present"
                },
                {
                  "field": "headers.list-unsubscribe-post",
                  "op": "present"
                },
                {
                  "field": "headers.precedence",
                  "op": "regex",
                  "value": "^(?:bulk|list)$"
                }
              ]
            }
          },
          {
            "not": {
              "all": [
                {
                  "field": "headers.auto-submitted",
                  "op": "present"
                },
                {
                  "not": {
                    "field": "headers.auto-submitted",
                    "op": "regex",
                    "value": "^no$"
                  }
                }
              ]
            }
          }
        ]
      },
      "set": {
        "category": "primary",
        "newsletter": false
      },
      "sources": [
        "dakia"
      ]
    },
    {
      "id": "transactions.order",
      "description": "An order confirmation with explicit confirmation wording.",
      "mode": "decision",
      "priority": 80,
      "when": {
        "field": "subject",
        "op": "regex",
        "value": "\\b(?:order confirmation|your order is confirmed|your order has been confirmed|thank you for your order|we've received your order|we’ve received your order)\\b"
      },
      "set": {
        "category": "transactions",
        "newsletter": false,
        "time_sensitive": false
      },
      "sources": [
        "gmail-inbox-cleaner",
        "dakia"
      ]
    },
    {
      "id": "transactions.order-number",
      "description": "An order identifier followed by confirmed.",
      "mode": "decision",
      "priority": 80,
      "when": {
        "field": "subject",
        "op": "regex",
        "value": "\\border[ \\t]{1,3}#?[a-z0-9-]{3,32}[ \\t]{1,3}confirmed\\b"
      },
      "set": {
        "category": "transactions",
        "newsletter": false,
        "time_sensitive": false
      },
      "sources": [
        "gmail-inbox-cleaner",
        "dakia"
      ]
    },
    {
      "id": "transactions.shipping",
      "description": "A routine shipment or delivery confirmation.",
      "mode": "decision",
      "priority": 80,
      "when": {
        "field": "subject",
        "op": "regex",
        "value": "\\b(?:shipping confirmation|shipment confirmation|your order has shipped|your package has shipped|delivery confirmation|your package is out for delivery)\\b"
      },
      "set": {
        "category": "transactions",
        "newsletter": false,
        "time_sensitive": false
      },
      "sources": [
        "gmail-inbox-cleaner",
        "dakia"
      ]
    },
    {
      "id": "transactions.receipt",
      "description": "A receipt or completed payment with supporting transaction details.",
      "mode": "decision",
      "priority": 80,
      "when": {
        "all": [
          {
            "field": "subject",
            "op": "regex",
            "value": "\\b(?:your receipt|receipt for|payment received|payment confirmation)\\b"
          },
          {
            "field": "text",
            "op": "regex",
            "value": "\\b(?:amount paid|total paid|thank you for your purchase|payment received|transaction id)\\b"
          }
        ]
      },
      "set": {
        "category": "transactions",
        "newsletter": false,
        "time_sensitive": false
      },
      "sources": [
        "gmail-inbox-cleaner",
        "dakia"
      ]
    },
    {
      "id": "transactions.invoice",
      "description": "An invoice, statement or tax document with an amount or document detail.",
      "mode": "decision",
      "priority": 80,
      "when": {
        "all": [
          {
            "field": "subject",
            "op": "regex",
            "value": "\\b(?:your invoice|invoice #[a-z0-9-]{1,32}|your statement|your tax document)\\b"
          },
          {
            "field": "text",
            "op": "regex",
            "value": "\\b(?:amount due|invoice number|statement period|tax year|total paid)\\b"
          }
        ]
      },
      "set": {
        "category": "transactions",
        "newsletter": false,
        "time_sensitive": false
      },
      "sources": [
        "gmail-inbox-cleaner",
        "dakia"
      ]
    },
    {
      "id": "transactions.booking",
      "description": "A completed booking or reservation.",
      "mode": "decision",
      "priority": 80,
      "when": {
        "field": "subject",
        "op": "regex",
        "value": "\\b(?:your booking is confirmed|your reservation is confirmed|your booking confirmation|your reservation confirmation)\\b"
      },
      "set": {
        "category": "transactions",
        "newsletter": false,
        "time_sensitive": false
      },
      "sources": [
        "dakia"
      ]
    },
    {
      "id": "updates.terms",
      "description": "A notice of changes to terms or privacy policy.",
      "mode": "decision",
      "priority": 75,
      "when": {
        "all": [
          {
            "field": "subject",
            "op": "regex",
            "value": "\\b(?:terms of service|terms and conditions|privacy policy)\\b"
          },
          {
            "any": [
              {
                "field": "subject",
                "op": "regex",
                "value": "\\b(?:updated|updates|changes|changing|new)\\b"
              },
              {
                "field": "text",
                "op": "regex",
                "value": "\\b(?:updated|updates|changes|changing|new)\\b"
              }
            ]
          }
        ]
      },
      "set": {
        "category": "updates",
        "newsletter": false
      },
      "sources": [
        "dakia"
      ]
    },
    {
      "id": "updates.calendar",
      "description": "A parsed calendar message or an explicit calendar invitation.",
      "mode": "decision",
      "priority": 75,
      "when": {
        "any": [
          {
            "field": "has_calendar_part",
            "op": "equals",
            "value": true
          },
          {
            "field": "subject",
            "op": "regex",
            "value": "^(?:invitation:|updated invitation:|accepted:|declined:)"
          },
          {
            "field": "text",
            "op": "regex",
            "value": "\\byou have been invited to the following event\\b"
          }
        ]
      },
      "set": {
        "category": "updates",
        "newsletter": false
      },
      "sources": [
        "gmail-inbox-cleaner",
        "dakia"
      ]
    },
    {
      "id": "updates.social",
      "description": "An authenticated social-service sender with a routine notification subject.",
      "mode": "decision",
      "priority": 60,
      "when": {
        "all": [
          {
            "field": "sender_authenticated",
            "op": "equals",
            "value": true
          },
          {
            "field": "sender_domain",
            "op": "domain_in",
            "value": [
              "redditmail.com",
              "reddit.com",
              "facebookmail.com",
              "instagram.com",
              "linkedin.com",
              "linkedinmail.com",
              "twitter.com",
              "x.com",
              "pinterest.com",
              "discord.com"
            ]
          },
          {
            "field": "subject",
            "op": "regex",
            "value": "\\b(?:new comment|new follower|new connection|mentioned you|liked your|invited you to connect)\\b"
          }
        ]
      },
      "set": {
        "category": "updates",
        "newsletter": false
      },
      "sources": [
        "gmail-inbox-cleaner",
        "dakia"
      ]
    },
    {
      "id": "updates.newsletter",
      "description": "Newsletter or digest subject plus subscription evidence.",
      "mode": "decision",
      "priority": 55,
      "when": {
        "all": [
          {
            "field": "subject",
            "op": "regex",
            "value": "\\b(?:newsletter|weekly digest|daily digest|weekly roundup|daily roundup|issue #[0-9]{1,6})\\b"
          },
          {
            "any": [
              {
                "any": [
                  {
                    "field": "headers.list-id",
                    "op": "present"
                  },
                  {
                    "field": "headers.list-unsubscribe",
                    "op": "present"
                  },
                  {
                    "field": "headers.list-unsubscribe-post",
                    "op": "present"
                  },
                  {
                    "field": "headers.precedence",
                    "op": "regex",
                    "value": "^(?:bulk|list)$"
                  }
                ]
              },
              {
                "field": "text",
                "op": "regex",
                "value": "\\bunsubscribe\\b"
              }
            ]
          },
          {
            "not": {
              "all": [
                {
                  "field": "sender_address",
                  "op": "present"
                },
                {
                  "field": "verified_correspondent",
                  "op": "equals",
                  "value": true
                },
                {
                  "any": [
                    {
                      "field": "headers.in-reply-to",
                      "op": "present"
                    },
                    {
                      "field": "headers.references",
                      "op": "present"
                    }
                  ]
                },
                {
                  "not": {
                    "any": [
                      {
                        "field": "headers.list-id",
                        "op": "present"
                      },
                      {
                        "field": "headers.list-unsubscribe",
                        "op": "present"
                      },
                      {
                        "field": "headers.list-unsubscribe-post",
                        "op": "present"
                      },
                      {
                        "field": "headers.precedence",
                        "op": "regex",
                        "value": "^(?:bulk|list)$"
                      }
                    ]
                  }
                },
                {
                  "not": {
                    "all": [
                      {
                        "field": "headers.auto-submitted",
                        "op": "present"
                      },
                      {
                        "not": {
                          "field": "headers.auto-submitted",
                          "op": "regex",
                          "value": "^no$"
                        }
                      }
                    ]
                  }
                }
              ]
            }
          }
        ]
      },
      "set": {
        "category": "updates",
        "newsletter": true
      },
      "sources": [
        "gmail-inbox-cleaner",
        "dakia"
      ]
    },
