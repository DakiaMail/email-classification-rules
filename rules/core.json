    {
      "id": "promotions.offer",
      "description": "Commerce wording and a shopping call to action, excluding verified correspondence.",
      "mode": "decision",
      "priority": 70,
      "when": {
        "all": [
          {
            "all": [
              {
                "any": [
                  {
                    "field": "subject",
                    "op": "regex",
                    "value": "\\b(?:[0-9]{1,3}%[ \\t]{0,3}off|discount|coupon|flash sale|on sale|special offer|exclusive offer|promo code|promotion code|clearance)\\b"
                  },
                  {
                    "field": "text",
                    "op": "regex",
                    "value": "\\b(?:[0-9]{1,3}%[ \\t]{0,3}off|discount|coupon|flash sale|on sale|special offer|exclusive offer|promo code|promotion code|clearance)\\b"
                  }
                ]
              },
              {
                "any": [
                  {
                    "field": "subject",
                    "op": "regex",
                    "value": "\\b(?:shop now|buy now|use code|claim your offer|redeem your offer)\\b"
                  },
                  {
                    "field": "text",
                    "op": "regex",
